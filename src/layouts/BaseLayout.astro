---
interface Props { title: string; description?: string; }
const { title, description = '世界のAIニュースを、毎朝わかりやすい日本語で。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/"><span>Y</span><strong>AI FRONTIER</strong></a>
      <nav aria-label="メインナビゲーション">
        <a href="/">最新ニュース</a><a href="/about/">このサイトについて</a><a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div><strong>AI FRONTIER</strong><p>世界のAIの動きを、日本語でコンパクトに。</p></div>
      <div><a href="/about/">運営方針</a><span> · </span><a href="/privacy/">プライバシー</a></div>
      <small>© {new Date().getFullYear()} YUMEUTSUTSU</small>
    </footer>
  </body>
</html>
<style is:global>
  :root{--ink:#10212b;--muted:#62727b;--paper:#f4f6f3;--card:#fff;--accent:#e84d2a;--line:#dce2de;--serif:"Yu Mincho","Hiragino Mincho ProN",serif;--sans:"Yu Gothic","Hiragino Kaku Gothic ProN",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.8}a{color:inherit;text-decoration:none}header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,24px);border-bottom:1px solid var(--line);background:rgba(244,246,243,.94);position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.brand{display:flex;align-items:center;gap:10px;letter-spacing:.12em}.brand span{display:grid;place-items:center;width:34px;height:34px;color:white;background:var(--accent);font-family:var(--serif);font-size:22px}nav{display:flex;gap:24px;font-size:14px}main{min-height:70vh}.wrap{width:min(1120px,90vw);margin:auto}footer{padding:54px max(5vw,24px);border-top:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:16px;color:var(--muted)}footer p{margin:.2rem 0}footer small{grid-column:1/-1}@media(max-width:680px){header{height:auto;padding-block:16px;align-items:flex-start}nav{gap:12px;flex-wrap:wrap;justify-content:flex-end;font-size:12px}.brand strong{font-size:13px}footer{grid-template-columns:1fr}}
</style>
