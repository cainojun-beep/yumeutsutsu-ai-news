---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){return (await getCollection('news',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('ja-JP',{dateStyle:'long'}).format(post.data.publishedAt);
---
<BaseLayout title={`${post.data.title}｜AI FRONTIER`} description={post.data.description}>
  <article class="article wrap"><a class="back" href="/">← 最新ニュースへ</a><p class="meta">{fmt} · {post.data.category}</p><h1>{post.data.title}</h1><p class="dek">{post.data.description}</p><div class="prose"><Content /></div><aside><h2>情報源</h2><ul>{post.data.sources.map(s=><li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name} ↗</a></li>)}</ul><p>本記事は公開情報をもとにAIを活用して下書きを作成し、情報源を明記しています。</p></aside></article>
</BaseLayout>
<style>.article{max-width:820px;padding:70px 0 110px}.back{color:var(--accent);font-weight:700}.meta{margin-top:55px;color:var(--muted);font-size:13px}.article h1{font-family:var(--serif);font-size:clamp(36px,6vw,62px);line-height:1.35;letter-spacing:-.03em}.dek{font-size:20px;color:var(--muted);border-left:4px solid var(--accent);padding-left:20px}.prose{font-family:var(--serif);font-size:18px;margin:60px 0}.prose :global(h2){font-size:30px;margin-top:2.2em}.prose :global(a),aside a{color:var(--accent);text-decoration:underline}aside{background:white;border:1px solid var(--line);padding:28px}aside h2{font-size:18px}aside p{font-size:12px;color:var(--muted)}</style>
